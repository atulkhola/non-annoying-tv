# Copy to .env. It is ignored by git, so your keys stay on your machine.

# console.anthropic.com. A Claude subscription doesn't include API access.
ANTHROPIC_API_KEY=
# movieofthenight.com, for what's streaming where.
MOTN_KEY=

# Two-letter country code.
COUNTRY=in
# The services you pay for, as the app knows them.
SERVICES=netflix,prime,hotstar
# The same services as Movie of the Night names them.
CATALOGS=netflix,prime.subscription,hotstar

# Your TV's address on your Wi-Fi.
TV_IP=

# scripts/setup_cloud.sh fills these two in.
APP_TOKEN=
WORKER_URL=
